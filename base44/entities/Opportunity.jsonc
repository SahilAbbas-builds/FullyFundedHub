{
    "name": "Opportunity",
    "type": "object",
    "properties": {
      "title": {
        "type": "string"
      },
      "organization": {
        "type": "string"
      },
      "country": {
        "type": "string"
      },
      "country_code": {
        "type": "string"
      },
      "opportunity_type": {
        "type": "string",
        "enum": [
          "Scholarship",
          "Internship"
        ],
        "default": "Scholarship"
      },
      "degree_level": {
        "type": "string",
        "enum": [
          "Undergraduate",
          "Masters",
          "PhD",
          "All Levels"
        ],
        "default": "Masters"
      },
      "field_of_study": {
        "type": "string"
      },
      "funding_type": {
        "type": "string",
        "enum": [
          "Full",
          "Partial"
        ],
        "default": "Full"
      },
      "funding_amount": {
        "type": "string"
      },
      "deadline": {
        "type": "string",
        "format": "date"
      },
      "application_url": {
        "type": "string"
      },
      "eligibility_criteria": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "raw_notes": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "is_featured": {
        "type": "boolean",
        "default": false
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "published",
          "inactive"
        ],
        "default": "draft"
      }
    },
    "required": [
      "title"
    ]
  }