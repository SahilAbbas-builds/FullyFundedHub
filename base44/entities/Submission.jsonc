{
    "name": "Submission",
    "type": "object",
    "properties": {
      "title": {
        "type": "string"
      },
      "organization": {
        "type": "string"
      },
      "country": {
        "type": "string"
      },
      "opportunity_type": {
        "type": "string",
        "enum": [
          "Scholarship",
          "Internship"
        ],
        "default": "Scholarship"
      },
      "degree_level": {
        "type": "string"
      },
      "field_of_study": {
        "type": "string"
      },
      "funding_type": {
        "type": "string",
        "enum": [
          "Full",
          "Partial"
        ],
        "default": "Full"
      },
      "funding_amount": {
        "type": "string"
      },
      "deadline": {
        "type": "string",
        "format": "date"
      },
      "application_url": {
        "type": "string"
      },
      "eligibility_criteria": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "submitter_name": {
        "type": "string"
      },
      "submitter_email": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "pending",
          "approved",
          "rejected"
        ],
        "default": "pending"
      }
    },
    "required": [
      "title"
    ]
  }